# Environment variables for DB+Chain Bridge MCP Server
# Copy this to .env and fill in the values

# --- Blockchain (Monad Testnet) ---
# Required for on-chain transactions. Generate a testnet key — never use a mainnet key.
PRIVATE_KEY=your_testnet_private_key_here
# Monad testnet RPC URL
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143

# --- Security Limits ---
# Maximum ETH per single transaction
MAX_SINGLE_TX_ETH=0.1
# Maximum transactions per server session
MAX_DAILY_TX_COUNT=5

# --- Allowed Database Paths (comma-separated, absolute paths) ---
ALLOWED_SQLITE_PATHS=/Users/skat/Projects/music-square/backend/data/music_square.db

# --- Allowed JSON File Paths (comma-separated) ---
ALLOWED_JSON_PATHS=/Users/skat/Projects/jobflow/jobs_db.json,/Users/skat/Projects/jobflow/applications_db.json,/Users/skat/Projects/jobflow/dashboard.json,/Users/skat/Projects/jobflow/profile.json
